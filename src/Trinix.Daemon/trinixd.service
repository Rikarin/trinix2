# trinixd — the first C# system service.
#
# The unit lives next to the code it starts rather than with the rest of the
# system configuration, because the two change together: a service that grows
# a new dependency needs its unit edited in the same commit.

[Unit]
Description=Trinix system service
Documentation=https://github.com/rikarin/trinix
# /data carries /var, and the journal is where this service's output goes.
After=local-fs.target
Wants=local-fs.target

[Service]
# Type=notify, not Type=simple: the host implements systemd's readiness
# protocol via AddSystemd(), so systemd knows when the service is actually up
# rather than when the process was forked. Anything ordered after it then gets
# a real guarantee instead of a race.
Type=notify
ExecStart=/usr/lib/trinix/daemon/trinixd
Restart=on-failure
RestartSec=5s

# A service never sees a login profile, so these are stated here.
#
# DOTNET_ROOT is not among them, deliberately. Trinix installs .NET to
# /usr/lib/dotnet rather than the /usr/share/dotnet an apphost looks in by
# default, and the answer is /etc/dotnet/install_location_<arch>, written by
# the dotnet recipe — one registration for the whole system instead of a line
# every unit has to remember. The unit that forgot it was the compositor, and
# what it printed was a page of advice about installing .NET onto a machine
# that already had it.
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
Environment=DOTNET_NOLOGO=1

# A service that reads os-release and /proc needs nothing else. Stated
# explicitly because the first service sets the pattern every later one copies,
# and "it worked as root" is a poor pattern to copy.
DynamicUser=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
NoNewPrivileges=yes
# The one hardening option a .NET service cannot take: the JIT writes code and
# then executes it, which is precisely what this forbids. NativeAOT components
# — the compositor, in Phase 4 — can and should set it to yes.
MemoryDenyWriteExecute=no

[Install]
WantedBy=multi-user.target
