<Project Sdk="Microsoft.NET.Sdk.Worker">

  <!--
    trinixd — the first C# process to run as a system service.

    Framework-dependent, not NativeAOT, and that is a decision rather than a
    default. The Phase 3 plan reserves AOT for the boot path and the
    compositor: things whose startup latency or GC behaviour is on a user's
    critical path. trinixd is neither, and framework-dependent has one property
    that matters more here — a portable build works for both architectures from
    one container, while NativeAOT cannot cross-compile between them. That
    problem has to be solved before the Phase 4 compositor ships; it does not
    have to be solved to prove that systemd can host a .NET service.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>trinixd</AssemblyName>
    <RootNamespace>Trinix.Daemon</RootNamespace>
    <UserSecretsId>trinix-daemon</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.0" />
  </ItemGroup>

</Project>
