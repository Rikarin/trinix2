<?xml version="1.0" encoding="utf-8"?>
<!--
    Where Trinix's C# gets its packages.

    Two sources, and the local one is the point. Vixen is developed in its own
    repository and consumed here as a pinned set of packages under
    ../vendor/vixen — see that directory's README for why it is packages rather
    than a submodule, and for how to move the pin.

    This file lives in src/ rather than at the repository root because that is
    the directory the build container is handed: `dotnet` walks up from each
    project and stops at the first NuGet.config, and a root one would be
    outside the context of the stage that needs it.
-->
<configuration>
    <packageSources>
        <!-- clear, so that a machine with a user-level NuGet.config full of
             private feeds builds the same tree as a clean container. -->
        <clear />
        <add key="vixen" value="../vendor/vixen" />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    </packageSources>

    <!--
        Vixen's packages come from the local folder and from nowhere else.
        Without this, a package id that exists on both sources is resolved by
        whichever answers first, and "Vixen.Ui" is not a name nuget.org has any
        reason to leave unclaimed forever.
    -->
    <packageSourceMapping>
        <packageSource key="vixen">
            <package pattern="Vixen.*" />
        </packageSource>
        <packageSource key="nuget.org">
            <package pattern="*" />
        </packageSource>
    </packageSourceMapping>
</configuration>
