<Project Sdk="Microsoft.NET.Sdk">

    <!--
      The first Vixen application on Trinix, and the Phase 5 gate for the
      platform backend: it is what -GraphicsCheck starts to prove that the chain
      from the compositor to a presented frame is whole.

      ⚠ It ships the way an application ships — src/pack-apps.sh builds it into
      a HelloUi.app, seals it with a signed Merkle manifest and packages it as a
      .tdi — rather than being published loose into /usr/lib like the compositor
      and the daemon. Those are parts of the system; this is an application, and
      Phase 6 already decided what an application is. Anything that installs and
      launches by a different route would be proving a path nothing else uses.

      Framework-dependent like every other Trinix application. NativeAOT would
      suit a UI application well and cannot cross-compile between architectures,
      which is the property src/publish.sh is organised around.
    -->

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <RootNamespace>Trinix.Apps.HelloUi</RootNamespace>
        <AssemblyName>helloui</AssemblyName>
        <IsPackable>false</IsPackable>

        <!-- Vixen's own trim analyser runs over the packages this pulls in and is
             not clean for a UI application yet; the boot-path components keep it. -->
        <IsAotCompatible>false</IsAotCompatible>
        <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Trinix.Platform\Trinix.Platform.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- The window, the device and the four steps of a frame. It brings
             Vixen.Ui and the control theme behind it — and, inside Vixen.Ui's own
             package, the VXML compiler and the buildTransitive .targets that makes
             Greeting.vxml compiler input. Neither needed adding to the pin. -->
        <PackageReference Include="Vixen.Ui.Desktop" Version="$(VixenVersion)" />

        <!--
            The tables, trees, docking and code editing doc 01 promises applications.
            A second package on purpose: an application that is one window of buttons
            should not link a virtualiser, so Vixen.Ui.Controls.Advanced is referenced
            by the applications that want it rather than reached transitively. This one
            wants it in order to prove the 2026-08-26 pin actually carries it.
        -->
        <PackageReference Include="Vixen.Ui.Controls.Advanced" Version="$(VixenVersion)" />
    </ItemGroup>

</Project>
