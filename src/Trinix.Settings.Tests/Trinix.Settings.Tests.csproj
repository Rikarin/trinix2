<Project Sdk="Microsoft.NET.Sdk">

    <!--
      Trinix.Settings.Tests — the store, against a real SQLite and real files.

      Nothing here is mocked. Every test opens an actual database in a temporary
      directory, because the three things doc 02 asks the store for — layer
      resolution, an atomic multi-key write, and one notification per change — are
      all properties of the *database*, and a fake would be a second implementation
      of exactly the part under test agreeing with itself.

      ⚠ **The SQLite here is not the SQLite that ships.** Trinix's target reaches
      libsqlite3.so.0 through SQLitePCLRaw's system provider; there is no such
      library on macOS, so these run against the bundled `e_sqlite3`. See
      ../Trinix.Settings/Trinix.Settings.csproj for how the choice is made and
      ProviderSeamTests.cs for what is done about it. In short: the store asserts
      `PRAGMA compile_options` at every open, it sets every pragma it depends on
      rather than inheriting a default, and ProviderSeamTests pins the divergences
      that are known so that a new one shows up as a failing test rather than as a
      surprise on a device.

      The provider package is *not* referenced here. It arrives transitively from
      Trinix.Settings, which is where the RID condition lives — a second copy of
      that decision in the test project is a second place for it to be wrong.
    -->

    <PropertyGroup>
        <RootNamespace>Trinix.Settings.Tests</RootNamespace>
        <AssemblyName>Trinix.Settings.Tests</AssemblyName>
        <IsPackable>false</IsPackable>

        <!-- The same opt-outs the other suites take: the rules they relax are about
             shipping, and a test assembly does not ship. The code under test keeps
             both analysers. -->
        <IsAotCompatible>false</IsAotCompatible>
        <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
        <EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Trinix.Settings\Trinix.Settings.csproj"/>
        <!-- The generator runs over this assembly too, so that the schemas the tests
             declare are generated by the same component the shipped one is. -->
        <ProjectReference Include="..\Trinix.Sdk.Generators\Trinix.Sdk.Generators.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1"/>
        <PackageReference Include="xunit" Version="2.9.3"/>
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit"/>
    </ItemGroup>

</Project>
