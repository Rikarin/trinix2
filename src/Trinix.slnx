<Solution>
    <!--
        Every .csproj under src/, without exception. scripts/check-solution.ps1
        proves that, and CI runs it before it builds: a project that is only in
        the tree is a project whose compile errors surface during a two-hour
        image build instead of in the ninety-second `dotnet` job.
    -->
    <Project Path="Trinix.ApiCheck/Trinix.ApiCheck.csproj"/>
    <Project Path="Trinix.Apps.Hello/Trinix.Apps.Hello.csproj"/>
    <Project Path="Trinix.Apps.HelloUi/Trinix.Apps.HelloUi.csproj"/>
    <Project Path="Trinix.Bundle/Trinix.Bundle.csproj"/>
    <Project Path="Trinix.Bundle.Tests/Trinix.Bundle.Tests.csproj"/>
    <Project Path="Trinix.Bundle.Tool/Trinix.Bundle.Tool.csproj"/>
    <Project Path="Trinix.Compositor/Trinix.Compositor.csproj"/>
    <Project Path="Trinix.Daemon/Trinix.Daemon.csproj"/>
    <Project Path="Trinix.Gatekeeper/Trinix.Gatekeeper.csproj"/>
    <Project Path="Trinix.Interop/Trinix.Interop.csproj"/>
    <Project Path="Trinix.Management/Trinix.Management.csproj"/>
    <Project Path="Trinix.Management.Tests/Trinix.Management.Tests.csproj"/>
    <Project Path="Trinix.Platform/Trinix.Platform.csproj"/>
    <Project Path="Trinix.Sandbox/Trinix.Sandbox.csproj"/>
    <Project Path="Trinix.Sandbox.Tests/Trinix.Sandbox.Tests.csproj"/>
    <Project Path="Trinix.Sdk.Generators/Trinix.Sdk.Generators.csproj"/>
    <Project Path="Trinix.Sdk.Generators.Tests/Trinix.Sdk.Generators.Tests.csproj"/>
    <Project Path="Trinix.Services.Contracts/Trinix.Services.Contracts.csproj"/>
    <Project Path="Trinix.Services.Contracts.Tests/Trinix.Services.Contracts.Tests.csproj"/>
    <Project Path="Trinix.Settings/Trinix.Settings.csproj"/>
    <Project Path="Trinix.Settings.Tests/Trinix.Settings.Tests.csproj"/>
</Solution>
