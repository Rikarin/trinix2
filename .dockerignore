# The build context is the repo root, but almost nothing from it belongs in the
# container: sources are fetched by digest, not copied.
.git
.github
.cache
out
docs
*.md
!IMPLEMENTATION_PLAN.md
**/bin
**/obj
**/.DS_Store
*.img
*.tdi
*.qcow2
# No key material in a build context, ever. The trust anchors an image needs
# reach it as a named build context (see scripts/build.ps1), and the signing key
# as a BuildKit secret — neither of which comes through here.
signing/**/*.key
signing/**/*.pem
