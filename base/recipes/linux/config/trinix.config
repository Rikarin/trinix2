# Trinix kernel configuration fragment.
#
# Merged on top of each architecture's `defconfig` rather than shipping a full
# .config per arch: a fragment stays readable, survives kernel version bumps,
# and makes every deliberate choice visible in one screen. Anything not named
# here is whatever upstream's defconfig decided, which is a defensible default.

# --- Boot ------------------------------------------------------------------
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_ZSTD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# --- Virtual hardware ------------------------------------------------------
# The VM tier is how Trinix is tested until real-hardware bring-up in Phase 8,
# so virtio is not optional.
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_HW_RANDOM_VIRTIO=y
# virtio-gpu is what gives the Phase 4 compositor real DRM/KMS inside a VM.
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=y

# --- Input -----------------------------------------------------------------
# evdev is how libinput — and therefore the Phase 4 compositor — sees a
# keyboard or a mouse at all. Both defconfigs enable it today; it is named here
# because "the desktop has no input" is a bad way to discover that changed.
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_MISC=y
CONFIG_INPUT_UINPUT=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_VIRTIO_INPUT=y

# --- Serial console --------------------------------------------------------
# The Phase 2 exit criterion is a login prompt over a serial console, so both
# arches need theirs built in rather than modular.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y

# --- Filesystems -----------------------------------------------------------
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_UTF8=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_OVERLAY_FS=y
CONFIG_AUTOFS_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y

# --- Integrity: the immutable-image model ----------------------------------
# dm-verity protects the base system image; fs-verity protects installed app
# bundles. Both are kernel primitives precisely so the signing policy layer
# does not have to invent crypto.
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_VERITY=y
CONFIG_FS_VERITY=y

# --- systemd's requirements ------------------------------------------------
# systemd refuses to boot without most of these; they are listed explicitly so
# a defconfig change upstream cannot quietly remove one.
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_INOTIFY_USER=y
CONFIG_FANOTIFY=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EPOLL=y
CONFIG_NET=y
CONFIG_INET=y
CONFIG_UNIX=y
CONFIG_SYSFS=y
CONFIG_PROC_FS=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# --- 32-bit compatibility: deliberately off --------------------------------
# Trinix is a 64-bit-only distribution. There is no 32-bit userland to support,
# so aarch32/ia32 emulation is dead weight.
#
# On arm64 this is also load-bearing for the build: defconfig enables
# CONFIG_COMPAT_VDSO, which compiles a 32-bit vDSO and therefore needs an ARM
# backend in LLVM. Trinix builds LLVM with AArch64, X86 and BPF only, so the
# kernel fails with "No available targets are compatible with triple
# thumbv8a-...". Widening the toolchain to fix that would be carrying a whole
# backend for an architecture the distribution does not ship.
# CONFIG_COMPAT is not set
# CONFIG_COMPAT_VDSO is not set
# CONFIG_IA32_EMULATION is not set

# --- Warnings are not build failures ----------------------------------------
# Trinix compiles an LTS kernel with a Clang several major versions newer than
# the one it was released against, which is a combination upstream never gates
# on. Clang 21 added -Wunterminated-string-initialization, and x86_64's
# defconfig turns warnings into errors — so the build dies on
# drivers/acpi/tables.c initialising char[4] from "BERT", which is deliberate,
# correct, and exactly what an ACPI signature is.
#
# CONFIG_WERROR exists to keep kernel developers honest about their own code.
# A distribution building someone else's release with a newer compiler is not
# that situation, which is why distributions turn it off.
# CONFIG_WERROR is not set

# --- Trimming --------------------------------------------------------------
# Not needed by an immutable, image-based distribution.
# CONFIG_MODULE_SIG_ALL is not set
CONFIG_DEBUG_INFO_NONE=y
