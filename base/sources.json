{
  "$schema": "./sources.schema.json",
  "$comment": [
    "The single source of truth for every upstream tarball Trinix builds from.",
    "LFS discipline: nothing is fetched that is not pinned here by version AND sha256.",
    "`${version}` and `${versionMajor}` are expanded in `url`.",
    "Run `scripts/update-sources.ps1` to (re)compute checksums after bumping a version.",
    "GNU components go through ftpmirror.gnu.org: ftp.gnu.org itself is regularly unreachable, and the pinned digest makes an untrusted mirror a non-issue."
  ],
  "sources": {
    "llvm-project": {
      "version": "21.1.0",
      "phase": 1,
      "url": "https://github.com/llvm/llvm-project/releases/download/llvmorg-${version}/llvm-project-${version}.src.tar.xz",
      "sha256": "1672e3efb4c2affd62dbbe12ea898b28a451416c7d95c1bd0190c26cbe878825",
      "notes": "Primary toolchain: clang, lld, compiler-rt, libunwind, libc++. One build targets both arches."
    },
    "binutils": {
      "version": "2.44",
      "phase": 1,
      "url": "https://ftpmirror.gnu.org/gnu/binutils/binutils-${version}.tar.xz",
      "sha256": "ce2017e059d63e67ddb9240e9d4ec49c2893605035cd60e92ad53177f4377237",
      "notes": "Needed only by the mini-GCC/glibc path; llvm-ar/objcopy/strip are used everywhere else."
    },
    "gcc": {
      "version": "14.2.0",
      "phase": 1,
      "url": "https://ftpmirror.gnu.org/gnu/gcc/gcc-${version}/gcc-${version}.tar.xz",
      "sha256": "a7b39bc69cbf9e25826c5a60ab26477001f7c08d85cec04bc0e29cabed6f3cc9",
      "notes": "Minimal cross-GCC, built solely to compile glibc + crt files, plus shippable libgcc_s/libstdc++ compat libraries. Held at 14.x deliberately: GCC 15 defaults to C23 and postdates glibc 2.41, and GCC 14.2.0 + glibc 2.41 is the combination LFS 12.3 ships. Nothing here benefits from a newer GCC."
    },
    "gmp": {
      "version": "6.3.0",
      "phase": 1,
      "url": "https://ftpmirror.gnu.org/gnu/gmp/gmp-${version}.tar.xz",
      "sha256": "a3c2b80201b89e68616f4ad30bc66aee4927c3ce50e33929ca819d5c43538898",
      "notes": "GCC prerequisite (versions match GCC 15's contrib/download_prerequisites)."
    },
    "mpfr": {
      "version": "4.2.1",
      "phase": 1,
      "url": "https://ftpmirror.gnu.org/gnu/mpfr/mpfr-${version}.tar.xz",
      "sha256": "277807353a6726978996945af13e52829e3abd7a9a5b7fb2793894e18f1fcbb2",
      "notes": "GCC prerequisite."
    },
    "mpc": {
      "version": "1.3.1",
      "phase": 1,
      "url": "https://ftpmirror.gnu.org/gnu/mpc/mpc-${version}.tar.gz",
      "sha256": "ab642492f5cf882b74aa0cb730cd410a81edcdbec895183ce930e706c1c759b8",
      "notes": "GCC prerequisite."
    },
    "isl": {
      "version": "0.24",
      "phase": 1,
      "url": "https://gcc.gnu.org/pub/gcc/infrastructure/isl-${version}.tar.bz2",
      "sha256": "fcf78dd9656c10eb8cf9fbd5f59a0b6b01386205fe1934b3b287a0a1898145c0",
      "notes": "GCC prerequisite (Graphite)."
    },
    "glibc": {
      "version": "2.41",
      "phase": 1,
      "url": "https://ftpmirror.gnu.org/gnu/glibc/glibc-${version}.tar.xz",
      "sha256": "a5a26b22f545d6b7d7b3dd828e11e428f24f4fac43c934fb071b6a7d0828e901",
      "notes": "The one permanent GCC dependency in the whole tree."
    },
    "linux": {
      "version": "6.12.30",
      "versionMajor": "6",
      "phase": 1,
      "url": "https://cdn.kernel.org/pub/linux/kernel/v${versionMajor}.x/linux-${version}.tar.xz",
      "sha256": "df046a48971e40ce0b2e003e7e55b6b1e7da2912120eb216d5d6c8450c9cf82e",
      "notes": "Phase 1 uses it for sanitised headers; Phase 2 builds it with LLVM=1. Mainline LTS."
    },
    "systemd": {
      "version": "257",
      "phase": 2,
      "url": "https://github.com/systemd/systemd/archive/refs/tags/v${version}.tar.gz",
      "sha256": "14f6907eb5e289d8c39cbe1ef891ca54d8a0e3582c986a9ef5844b3f29add43b",
      "notes": "PID 1, udev, logind, systemd-boot, boot-attempts based A/B rollback."
    },
    "util-linux": {
      "version": "2.40.4",
      "versionMajor": "2.40",
      "phase": 2,
      "url": "https://cdn.kernel.org/pub/linux/utils/util-linux/v${versionMajor}/util-linux-${version}.tar.xz",
      "sha256": "5c1daf733b04e9859afdc3bd87cc481180ee0f88b5c0946b16fdec931975fb79",
      "notes": "libmount/libblkid are hard systemd dependencies."
    },
    "coreutils": {
      "version": "9.6",
      "phase": 2,
      "url": "https://ftpmirror.gnu.org/gnu/coreutils/coreutils-${version}.tar.xz",
      "sha256": "7a0124327b398fd9eb1a6abde583389821422c744ffa10734b24f557610d3283"
    },
    "busybox": {
      "version": "1.37.0",
      "phase": 2,
      "url": "https://busybox.net/downloads/busybox-${version}.tar.bz2",
      "sha256": "3311dff32e746499f4df0d5df04d7eb396382d7e108bb9250e7b519b837043a4",
      "notes": "Initramfs userland; keeps the early-boot image tiny."
    },
    "bash": {
      "version": "5.2.37",
      "phase": 2,
      "url": "https://ftpmirror.gnu.org/gnu/bash/bash-${version}.tar.gz",
      "sha256": "9599b22ecd1d5787ad7d3b7bf0c59f312b3396d1e281175dd1f8a4014da621ff",
      "notes": "Interactive fallback / rescue shell. PowerShell is the user-facing shell."
    },
    "dash": {
      "version": "0.5.12",
      "phase": 2,
      "url": "http://gondor.apana.org.au/~herbert/dash/files/dash-${version}.tar.gz",
      "sha256": "6a474ac46e8b0b32916c4c60df694c82058d3297d8b385b74508030ca4a8f28a",
      "notes": "/bin/sh — thousands of scripts and systemd generators hardcode it."
    },
    "dbus": {
      "version": "1.16.0",
      "phase": 2,
      "url": "https://dbus.freedesktop.org/releases/dbus/dbus-${version}.tar.xz",
      "sha256": "9f8ca5eb51cbe09951aec8624b86c292990ae2428b41b856e2bed17ec65c8849"
    },
    "openssl": {
      "version": "3.5.0",
      "phase": 2,
      "url": "https://github.com/openssl/openssl/releases/download/openssl-${version}/openssl-${version}.tar.gz",
      "sha256": "344d0a79f1a9b08029b0744e2cc401a43f9c90acd1044d09a530b4885a8e9fc0",
      "notes": "TLS for the system; .NET's crypto stack links against it."
    },
    "cacert": {
      "version": "2026-07-16",
      "phase": 2,
      "url": "https://curl.se/ca/cacert-${version}.pem",
      "sha256": "3ff344e30b9b1ed2971044eabb438a08f2e2245ddb5f8ab1a3ad8b63ab4eaf91",
      "notes": "Mozilla's CA trust store, as extracted by the curl project. Pinned by date rather than tracking cacert.pem, whose contents change under a fixed URL. No recipe yet: nothing in the base image speaks TLS, and the store arrives with .NET in Phase 3. Pinned now so CI verifies it and the version is a one-line change when it does."
    },
    "zlib": {
      "version": "1.3.1",
      "phase": 2,
      "url": "https://zlib.net/fossils/zlib-${version}.tar.gz",
      "sha256": "9a93b2b7dfdac77ceba5a558a580e74667dd6fede4585b91eefb60f03b72df23"
    },
    "xz": {
      "version": "5.6.3",
      "phase": 2,
      "url": "https://github.com/tukaani-project/xz/releases/download/v${version}/xz-${version}.tar.xz",
      "sha256": "db0590629b6f0fa36e74aea5f9731dc6f8df068ce7b7bafa45301832a5eebc3a"
    },
    "zstd": {
      "version": "1.5.6",
      "phase": 2,
      "url": "https://github.com/facebook/zstd/releases/download/v${version}/zstd-${version}.tar.gz",
      "sha256": "8c29e06cf42aacc1eafc4077ae2ec6c6fcb96a626157e0593d5e82a34fd403c1",
      "notes": "Kernel/initramfs compression and .tdi image compression."
    },
    "libxcrypt": {
      "version": "4.4.36",
      "phase": 2,
      "url": "https://github.com/besser82/libxcrypt/releases/download/v${version}/libxcrypt-${version}.tar.xz",
      "sha256": "e5e1f4caee0a01de2aee26e3138807d6d3ca2b8e67287966d1fefd65e1fd8943",
      "notes": "crypt(3). glibc removed libcrypt upstream, and systemd links it unconditionally; PAM and shadow will need it too."
    },
    "shadow": {
      "version": "4.17.4",
      "phase": 2,
      "url": "https://github.com/shadow-maint/shadow/releases/download/${version}/shadow-${version}.tar.xz",
      "sha256": "554801054694ff7d8a7abdf0d6ece34e2f16e111673cc01b8c9ee1278451181e",
      "notes": "login, passwd, useradd. util-linux's login has required PAM since 2.34, and this one does not — so a from-scratch base gets an authenticating login prompt without pulling in PAM."
    },
    "libcap": {
      "version": "2.73",
      "phase": 2,
      "url": "https://cdn.kernel.org/pub/linux/libs/security/linux-privs/libcap2/libcap-${version}.tar.xz",
      "sha256": "6405f6089cf4cdd8c271540cd990654d78dd0b1989b2d9bda20f933a75a795a5",
      "notes": "systemd dependency."
    },
    "kmod": {
      "version": "34",
      "phase": 2,
      "url": "https://cdn.kernel.org/pub/linux/utils/kernel/kmod/kmod-${version}.tar.xz",
      "sha256": "12e7884484151fbd432b6a520170ea185c159f4393c7a2c2a886ab820313149a",
      "notes": "systemd dependency."
    },
    "pcre2": {
      "version": "10.45",
