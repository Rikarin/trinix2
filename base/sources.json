      "url": "https://github.com/libexpat/libexpat/releases/download/R_2_6_4/expat-${version}.tar.xz",
      "sha256": "a695629dae047055b37d50a0ff4776d1d45d0a4c842cf4ccee158441f55ff7ee",
      "notes": "dbus dependency."
    },
    "libffi": {
      "version": "3.4.7",
      "phase": 2,
      "url": "https://github.com/libffi/libffi/releases/download/v${version}/libffi-${version}.tar.gz",
      "sha256": "138607dee268bdecf374adf9144c00e839e38541f75f24a1fcf18b78fda48b2d"
    },
    "ncurses": {
      "version": "6.5",
      "phase": 2,
      "url": "https://ftpmirror.gnu.org/gnu/ncurses/ncurses-${version}.tar.gz",
      "sha256": "136d91bc269a9a5785e5f9e980bc76ab57428f604ce3e5a5a90cebc767971cc6"
    },
    "readline": {
      "version": "8.2.13",
      "phase": 2,
      "url": "https://ftpmirror.gnu.org/gnu/readline/readline-${version}.tar.gz",
      "sha256": "0e5be4d2937e8bd9b7cd60d46721ce79f88a33415dd68c2d738fb5924638f656"
    },
    "iproute2": {
      "version": "6.13.0",
      "phase": 2,
      "url": "https://cdn.kernel.org/pub/linux/utils/net/iproute2/iproute2-${version}.tar.xz",
      "sha256": "a43aa43338d882b44d01e549f3f105a92ae9feea32a82fae45a88e7a49302819"
    },
    "e2fsprogs": {
      "version": "1.47.2",
      "phase": 2,
      "url": "https://cdn.kernel.org/pub/linux/kernel/people/tytso/e2fsprogs/v${version}/e2fsprogs-${version}.tar.xz",
      "sha256": "08242e64ca0e8194d9c1caad49762b19209a06318199b63ce74ae4ef2d74e63c"
    },
    "dosfstools": {
      "version": "4.2",
      "phase": 2,
      "url": "https://github.com/dosfstools/dosfstools/releases/download/v${version}/dosfstools-${version}.tar.gz",
      "sha256": "64926eebf90092dca21b14259a5301b7b98e7b1943e8a201c7d726084809b527",
      "notes": "mkfs.vfat for the ESP."
    },
    "erofs-utils": {
      "version": "1.8.6",
      "phase": 2,
      "url": "https://git.kernel.org/pub/scm/linux/kernel/git/xiang/erofs-utils.git/snapshot/erofs-utils-${version}.tar.gz",
      "sha256": "5b221dc3fd6d151425b30534ede46fb7a90dc233a8659cba0372796b0a066547",
      "notes": "Read-only base image and the .tdi distribution format. NOTE: cgit generates this snapshot on the fly, so the digest is only stable as long as the server's tar/gzip settings are — switch to a release tarball if it ever churns."
    },
    "squashfs-tools": {
      "version": "4.6.1",
      "phase": 2,
      "url": "https://github.com/plougher/squashfs-tools/archive/refs/tags/${version}.tar.gz",
