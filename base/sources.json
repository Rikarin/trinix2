{
  "$schema": "./sources.schema.json",
  "$comment": [
    "The single source of truth for every upstream tarball Trinix builds from.",
    "LFS discipline: nothing is fetched that is not pinned here by version AND sha256.",
    "`${version}` and `${versionMajor}` are expanded in `url`.",
    "Run `scripts/update-sources.ps1` to (re)compute checksums after bumping a version.",
    "GNU components go through ftpmirror.gnu.org: ftp.gnu.org itself is regularly unreachable, and the pinned digest makes an untrusted mirror a non-issue."
  ],
  "sources": {
    "llvm-project": {
      "version": "21.1.0",
      "phase": 1,
      "url": "https://github.com/llvm/llvm-project/releases/download/llvmorg-${version}/llvm-project-${version}.src.tar.xz",
      "sha256": "1672e3efb4c2affd62dbbe12ea898b28a451416c7d95c1bd0190c26cbe878825",
      "notes": "Primary toolchain: clang, lld, compiler-rt, libunwind, libc++. One build targets both arches."
    },
    "binutils": {
      "version": "2.44",
      "phase": 1,
      "url": "https://ftpmirror.gnu.org/gnu/binutils/binutils-${version}.tar.xz",
      "sha256": "ce2017e059d63e67ddb9240e9d4ec49c2893605035cd60e92ad53177f4377237",
      "notes": "Needed only by the mini-GCC/glibc path; llvm-ar/objcopy/strip are used everywhere else."
    },
    "gcc": {
      "version": "14.2.0",
      "phase": 1,
      "url": "https://ftpmirror.gnu.org/gnu/gcc/gcc-${version}/gcc-${version}.tar.xz",
      "sha256": "a7b39bc69cbf9e25826c5a60ab26477001f7c08d85cec04bc0e29cabed6f3cc9",
      "notes": "Minimal cross-GCC, built solely to compile glibc + crt files, plus shippable libgcc_s/libstdc++ compat libraries. Held at 14.x deliberately: GCC 15 defaults to C23 and postdates glibc 2.41, and GCC 14.2.0 + glibc 2.41 is the combination LFS 12.3 ships. Nothing here benefits from a newer GCC."
    },
    "gmp": {
      "version": "6.3.0",
      "phase": 1,
      "url": "https://ftpmirror.gnu.org/gnu/gmp/gmp-${version}.tar.xz",
      "sha256": "a3c2b80201b89e68616f4ad30bc66aee4927c3ce50e33929ca819d5c43538898",
      "notes": "GCC prerequisite (versions match GCC 15's contrib/download_prerequisites)."
    },
    "mpfr": {
      "version": "4.2.1",
      "phase": 1,
      "url": "https://ftpmirror.gnu.org/gnu/mpfr/mpfr-${version}.tar.xz",
      "sha256": "277807353a6726978996945af13e52829e3abd7a9a5b7fb2793894e18f1fcbb2",
      "notes": "GCC prerequisite."
    },
    "mpc": {
      "version": "1.3.1",
      "phase": 1,
      "url": "https://ftpmirror.gnu.org/gnu/mpc/mpc-${version}.tar.gz",
      "sha256": "ab642492f5cf882b74aa0cb730cd410a81edcdbec895183ce930e706c1c759b8",
      "notes": "GCC prerequisite."
    },
    "isl": {
      "version": "0.24",
      "phase": 1,
      "url": "https://gcc.gnu.org/pub/gcc/infrastructure/isl-${version}.tar.bz2",
      "sha256": "fcf78dd9656c10eb8cf9fbd5f59a0b6b01386205fe1934b3b287a0a1898145c0",
      "notes": "GCC prerequisite (Graphite)."
    },
    "glibc": {
      "version": "2.41",
      "phase": 1,
      "url": "https://ftpmirror.gnu.org/gnu/glibc/glibc-${version}.tar.xz",
      "sha256": "a5a26b22f545d6b7d7b3dd828e11e428f24f4fac43c934fb071b6a7d0828e901",
      "notes": "The one permanent GCC dependency in the whole tree."
    },
    "linux": {
      "version": "6.12.30",
      "versionMajor": "6",
      "phase": 1,
      "url": "https://cdn.kernel.org/pub/linux/kernel/v${versionMajor}.x/linux-${version}.tar.xz",
      "sha256": "df046a48971e40ce0b2e003e7e55b6b1e7da2912120eb216d5d6c8450c9cf82e",
      "notes": "Phase 1 uses it for sanitised headers; Phase 2 builds it with LLVM=1. Mainline LTS."
    },
    "systemd": {
      "version": "257",
      "phase": 2,
      "url": "https://github.com/systemd/systemd/archive/refs/tags/v${version}.tar.gz",
      "sha256": "14f6907eb5e289d8c39cbe1ef891ca54d8a0e3582c986a9ef5844b3f29add43b",
      "notes": "PID 1, udev, logind, systemd-boot, boot-attempts based A/B rollback."
    },
    "util-linux": {
      "version": "2.40.4",
      "versionMajor": "2.40",
      "phase": 2,
      "url": "https://cdn.kernel.org/pub/linux/utils/util-linux/v${versionMajor}/util-linux-${version}.tar.xz",
      "sha256": "5c1daf733b04e9859afdc3bd87cc481180ee0f88b5c0946b16fdec931975fb79",
      "notes": "libmount/libblkid are hard systemd dependencies."
    },
    "coreutils": {
      "version": "9.6",
      "phase": 2,
      "url": "https://ftpmirror.gnu.org/gnu/coreutils/coreutils-${version}.tar.xz",
      "sha256": "7a0124327b398fd9eb1a6abde583389821422c744ffa10734b24f557610d3283"
    },
    "busybox": {
      "version": "1.37.0",
      "phase": 2,
      "url": "https://busybox.net/downloads/busybox-${version}.tar.bz2",
      "sha256": "3311dff32e746499f4df0d5df04d7eb396382d7e108bb9250e7b519b837043a4",
      "notes": "Initramfs userland; keeps the early-boot image tiny."
    },
    "bash": {
      "version": "5.2.37",
      "phase": 2,
      "url": "https://ftpmirror.gnu.org/gnu/bash/bash-${version}.tar.gz",
      "sha256": "9599b22ecd1d5787ad7d3b7bf0c59f312b3396d1e281175dd1f8a4014da621ff",
      "notes": "Interactive fallback / rescue shell. PowerShell is the user-facing shell."
    },
    "dash": {
      "version": "0.5.12",
      "phase": 2,
      "url": "http://gondor.apana.org.au/~herbert/dash/files/dash-${version}.tar.gz",
      "sha256": "6a474ac46e8b0b32916c4c60df694c82058d3297d8b385b74508030ca4a8f28a",
      "notes": "/bin/sh — thousands of scripts and systemd generators hardcode it."
    },
    "dbus": {
      "version": "1.16.0",
      "phase": 2,
      "url": "https://dbus.freedesktop.org/releases/dbus/dbus-${version}.tar.xz",
      "sha256": "9f8ca5eb51cbe09951aec8624b86c292990ae2428b41b856e2bed17ec65c8849"
    },
    "openssl": {
      "version": "3.5.0",
      "phase": 2,
      "url": "https://github.com/openssl/openssl/releases/download/openssl-${version}/openssl-${version}.tar.gz",
      "sha256": "344d0a79f1a9b08029b0744e2cc401a43f9c90acd1044d09a530b4885a8e9fc0",
      "notes": "TLS for the system; .NET's crypto stack links against it."
    },
    "cacert": {
      "version": "2026-07-16",
      "phase": 2,
      "url": "https://curl.se/ca/cacert-${version}.pem",
      "sha256": "3ff344e30b9b1ed2971044eabb438a08f2e2245ddb5f8ab1a3ad8b63ab4eaf91",
      "notes": "Mozilla's CA trust store, as extracted by the curl project. Pinned by date rather than tracking cacert.pem, whose contents change under a fixed URL — a trust store is the last thing that should be able to change without the digest noticing."
    },
    "zlib": {
      "version": "1.3.1",
      "phase": 2,
      "url": "https://zlib.net/fossils/zlib-${version}.tar.gz",
      "sha256": "9a93b2b7dfdac77ceba5a558a580e74667dd6fede4585b91eefb60f03b72df23"
    },
    "xz": {
      "version": "5.6.3",
      "phase": 2,
      "url": "https://github.com/tukaani-project/xz/releases/download/v${version}/xz-${version}.tar.xz",
      "sha256": "db0590629b6f0fa36e74aea5f9731dc6f8df068ce7b7bafa45301832a5eebc3a"
    },
    "zstd": {
      "version": "1.5.6",
      "phase": 2,
      "url": "https://github.com/facebook/zstd/releases/download/v${version}/zstd-${version}.tar.gz",
      "sha256": "8c29e06cf42aacc1eafc4077ae2ec6c6fcb96a626157e0593d5e82a34fd403c1",
      "notes": "Kernel/initramfs compression and .tdi image compression."
    },
    "libxcrypt": {
      "version": "4.4.36",
      "phase": 2,
      "url": "https://github.com/besser82/libxcrypt/releases/download/v${version}/libxcrypt-${version}.tar.xz",
      "sha256": "e5e1f4caee0a01de2aee26e3138807d6d3ca2b8e67287966d1fefd65e1fd8943",
      "notes": "crypt(3). glibc removed libcrypt upstream, and systemd links it unconditionally; PAM and shadow will need it too."
    },
    "shadow": {
      "version": "4.17.4",
      "phase": 2,
      "url": "https://github.com/shadow-maint/shadow/releases/download/${version}/shadow-${version}.tar.xz",
      "sha256": "554801054694ff7d8a7abdf0d6ece34e2f16e111673cc01b8c9ee1278451181e",
      "notes": "login, passwd, useradd. util-linux's login has required PAM since 2.34, and this one does not — so a from-scratch base gets an authenticating login prompt without pulling in PAM."
    },
    "libcap": {
      "version": "2.73",
      "phase": 2,
      "url": "https://cdn.kernel.org/pub/linux/libs/security/linux-privs/libcap2/libcap-${version}.tar.xz",
      "sha256": "6405f6089cf4cdd8c271540cd990654d78dd0b1989b2d9bda20f933a75a795a5",
      "notes": "systemd dependency."
    },
    "kmod": {
      "version": "34",
      "phase": 2,
      "url": "https://cdn.kernel.org/pub/linux/utils/kernel/kmod/kmod-${version}.tar.xz",
      "sha256": "12e7884484151fbd432b6a520170ea185c159f4393c7a2c2a886ab820313149a",
      "notes": "systemd dependency."
    },
    "pcre2": {
      "version": "10.45",
      "phase": 2,
      "url": "https://github.com/PCRE2Project/pcre2/releases/download/pcre2-${version}/pcre2-${version}.tar.bz2",
      "sha256": "21547f3516120c75597e5b30a992e27a592a31950b5140e7b8bfde3f192033c4"
    },
    "expat": {
      "version": "2.6.4",
      "phase": 2,
      "url": "https://github.com/libexpat/libexpat/releases/download/R_2_6_4/expat-${version}.tar.xz",
      "sha256": "a695629dae047055b37d50a0ff4776d1d45d0a4c842cf4ccee158441f55ff7ee",
      "notes": "dbus dependency."
    },
    "libffi": {
      "version": "3.4.7",
      "phase": 2,
      "url": "https://github.com/libffi/libffi/releases/download/v${version}/libffi-${version}.tar.gz",
      "sha256": "138607dee268bdecf374adf9144c00e839e38541f75f24a1fcf18b78fda48b2d"
    },
    "ncurses": {
      "version": "6.5",
      "phase": 2,
      "url": "https://ftpmirror.gnu.org/gnu/ncurses/ncurses-${version}.tar.gz",
      "sha256": "136d91bc269a9a5785e5f9e980bc76ab57428f604ce3e5a5a90cebc767971cc6"
    },
    "readline": {
      "version": "8.2.13",
      "phase": 2,
      "url": "https://ftpmirror.gnu.org/gnu/readline/readline-${version}.tar.gz",
      "sha256": "0e5be4d2937e8bd9b7cd60d46721ce79f88a33415dd68c2d738fb5924638f656"
    },
    "iproute2": {
      "version": "6.13.0",
      "phase": 2,
      "url": "https://cdn.kernel.org/pub/linux/utils/net/iproute2/iproute2-${version}.tar.xz",
      "sha256": "a43aa43338d882b44d01e549f3f105a92ae9feea32a82fae45a88e7a49302819"
    },
    "e2fsprogs": {
      "version": "1.47.2",
      "phase": 2,
      "url": "https://cdn.kernel.org/pub/linux/kernel/people/tytso/e2fsprogs/v${version}/e2fsprogs-${version}.tar.xz",
      "sha256": "08242e64ca0e8194d9c1caad49762b19209a06318199b63ce74ae4ef2d74e63c"
    },
    "dosfstools": {
      "version": "4.2",
      "phase": 2,
      "url": "https://github.com/dosfstools/dosfstools/releases/download/v${version}/dosfstools-${version}.tar.gz",
      "sha256": "64926eebf90092dca21b14259a5301b7b98e7b1943e8a201c7d726084809b527",
      "notes": "mkfs.vfat for the ESP."
    },
    "erofs-utils": {
      "version": "1.8.6",
      "phase": 2,
      "url": "https://git.kernel.org/pub/scm/linux/kernel/git/xiang/erofs-utils.git/snapshot/erofs-utils-${version}.tar.gz",
      "sha256": "5b221dc3fd6d151425b30534ede46fb7a90dc233a8659cba0372796b0a066547",
      "notes": "Read-only base image and the .tdi distribution format. NOTE: cgit generates this snapshot on the fly, so the digest is only stable as long as the server's tar/gzip settings are — switch to a release tarball if it ever churns."
    },
    "squashfs-tools": {
      "version": "4.6.1",
      "phase": 2,
      "url": "https://github.com/plougher/squashfs-tools/archive/refs/tags/${version}.tar.gz",
      "sha256": "9c4974e07c61547dae14af4ed1f358b7d04618ae194e54d6be72ee126f0d2f53",
      "notes": "Alternative to erofs for .tdi; decided in Phase 6. NOTE: GitHub auto-generated archive, same digest-stability caveat as erofs-utils."
    },
    "icu": {
      "version": "77_1",
      "phase": 3,
      "url": "https://github.com/unicode-org/icu/releases/download/release-77-1/icu4c-${version}-src.tgz",
      "sha256": "588e431f77327c39031ffbb8843c0e3bc122c211374485fa87dc5f3faff24061",
      "notes": "Globalization for .NET, which refuses to start without it unless invariant mode is forced. NOTE: the release tag spells the version 77-1 while the tarball spells it 77_1, so a version bump is two edits here rather than one."
    },
    "dotnet-sdk-arm64": {
      "version": "10.0.302",
      "phase": 3,
      "url": "https://builds.dotnet.microsoft.com/dotnet/Sdk/${version}/dotnet-sdk-${version}-linux-arm64.tar.gz",
      "sha256": "1c56318e4099990719f6369184e08bbad0248c09c5ad7532d2516e3cdfc3ab6d",
      "notes": "Microsoft's official build. One entry per architecture because the manifest pins a URL, not a URL template — and because the two are genuinely different artefacts with different digests. Keep in step with global.json."
    },
    "dotnet-sdk-x86_64": {
      "version": "10.0.302",
      "phase": 3,
      "url": "https://builds.dotnet.microsoft.com/dotnet/Sdk/${version}/dotnet-sdk-${version}-linux-x64.tar.gz",
      "sha256": "264a838d6f5d1a252489c7bb2e2946a579d6a881391d50ffd175a01e4d948c1c",
      "notes": "See dotnet-sdk-arm64."
    },
    "powershell-arm64": {
      "version": "7.6.4",
      "phase": 3,
      "url": "https://github.com/PowerShell/PowerShell/releases/download/v${version}/powershell-${version}-linux-arm64.tar.gz",
      "sha256": "d4ef2382fa452f2ccbdb48a01adbbce9ed64954872123970c16be6d086d1224b",
      "notes": "The distribution's interactive shell. Self-contained rather than framework-dependent: pwsh has to start when the shared runtime is what is broken, which is exactly when a shell matters."
    },
    "powershell-x86_64": {
      "version": "7.6.4",
      "phase": 3,
      "url": "https://github.com/PowerShell/PowerShell/releases/download/v${version}/powershell-${version}-linux-x64.tar.gz",
      "sha256": "4471b5a36bfe86ec7af8525d36bb1cacba0128e7aac22d05cc064bc00e604721",
      "notes": "See powershell-arm64."
    },
    "wayland": {
      "version": "1.24.0",
      "phase": 4,
      "url": "https://gitlab.freedesktop.org/wayland/wayland/-/releases/${version}/downloads/wayland-${version}.tar.xz",
      "sha256": "82892487a01ad67b334eca83b54317a7c86a03a89cfadacfef5211f11a5d0536",
      "notes": "The protocol library, client and server halves. Built twice: once for the build machine, purely for wayland-scanner, and once for the target. The scanner generates C that is compiled into target binaries, which is exactly the kind of thing that must not come from the host distribution."
    },
    "wayland-protocols": {
      "version": "1.45",
      "phase": 4,
      "url": "https://gitlab.freedesktop.org/wayland/wayland-protocols/-/releases/${version}/downloads/wayland-protocols-${version}.tar.xz",
      "sha256": "4d2b2a9e3e099d017dc8107bf1c334d27bb87d9e4aff19a0c8d856d17cd41ef0",
      "notes": "XML only — xdg-shell and friends. Architecture-independent, and the one recipe in the base set that installs no code at all."
    },
    "libdrm": {
      "version": "2.4.125",
      "phase": 4,
      "url": "https://dri.freedesktop.org/libdrm/libdrm-${version}.tar.xz",
      "sha256": "d4bae92797a50f81a93524762e0410a49cd84cfa0f997795bc0172ac8fb1d96a",
      "notes": "Userspace half of the kernel's DRM/KMS interface: modesetting, and the dumb buffers Trinix's compositor draws into."
    },
    "pixman": {
      "version": "0.46.0",
      "phase": 4,
      "url": "https://www.cairographics.org/releases/pixman-${version}.tar.gz",
      "sha256": "02d9ff7b8458ef61731c3d355f854bbf461fd0a4d3563c51f1c1c7b00638050d",
      "notes": "Software rasteriser. Not a fallback here but the actual renderer — see base/recipes/wlroots/recipe.sh for why there is no GL in the image yet."
    },
    "libevdev": {
      "version": "1.13.6",
      "phase": 4,
      "url": "https://www.freedesktop.org/software/libevdev/libevdev-${version}.tar.xz",
      "sha256": "73f215eccbd8233f414737ac06bca2687e67c44b97d2d7576091aa9718551110",
      "notes": "Wrapper over the kernel's evdev protocol; libinput's substrate."
    },
    "mtdev": {
      "version": "1.1.7",
      "phase": 4,
      "url": "https://bitmath.org/code/mtdev/mtdev-${version}.tar.bz2",
      "sha256": "a107adad2101fecac54ac7f9f0e0a0dd155d954193da55c2340c97f2ff1d814e",
      "notes": "Multitouch protocol translation. Here only because libinput declares it unconditionally; nothing else in Trinix links against it."
    },
    "libinput": {
      "version": "1.28.1",
      "phase": 4,
      "url": "https://gitlab.freedesktop.org/libinput/libinput/-/archive/${version}/libinput-${version}.tar.gz",
      "sha256": "a13f8c9a7d93df3c85c66afd135f0296701d8d32f911991b7aa4273fdd6a42a3",
      "notes": "Pointer acceleration, tap-to-click, scroll — the input policy no compositor should reimplement. Pinned below 1.29, which introduces Lua plugins and with them an interpreter the base image has no other use for. NOTE: GitLab auto-generated archive; libinput stopped publishing release tarballs after 1.19."
    },
    "libxkbcommon": {
      "version": "1.13.2",
      "phase": 4,
      "url": "https://github.com/xkbcommon/libxkbcommon/archive/refs/tags/xkbcommon-${version}.tar.gz",
      "sha256": "acc4d5f7c3cbba5f9f8d08d8bdbeede84ecede46792f47929aa9321873385528",
      "notes": "Keymap compilation and keysym lookup. NOTE: GitHub auto-generated archive; xkbcommon.org no longer serves release tarballs."
    },
    "xkeyboard-config": {
      "version": "2.48",
      "phase": 4,
      "url": "https://www.x.org/archive/individual/data/xkeyboard-config/xkeyboard-config-${version}.tar.xz",
      "sha256": "b77041324f0109f77161ee43743fe04baa485866af8460d31e476ad3f7648fd5",
      "notes": "The keymap database libxkbcommon compiles at runtime. Data, not code — but without it every key is unmapped."
    },
    "hwdata": {
      "version": "0.410",
      "phase": 4,
      "url": "https://github.com/vcrhonek/hwdata/archive/refs/tags/v${version}.tar.gz",
      "sha256": "2864b061b179b8ad8cb6a7339ca07678240a183d9cedce8677a4950acaf798e0",
      "notes": "Consulted on the *build* machine, not the target: wlroots compiles pnp.ids into a table so it can name a monitor from its EDID. NOTE: GitHub auto-generated archive."
    },
    "libdisplay-info": {
      "version": "0.2.0",
      "phase": 4,
      "url": "https://gitlab.freedesktop.org/emersion/libdisplay-info/-/releases/${version}/downloads/libdisplay-info-${version}.tar.xz",
      "sha256": "5a2f002a16f42dd3540c8846f80a90b8f4bdcd067a94b9d2087bc2feae974176",
      "notes": "EDID and DisplayID parsing, required by wlroots' DRM backend. Held at 0.2.0, the version wlroots 0.19 declares and was tested against."
    },
    "seatd": {
      "version": "0.9.1",
      "phase": 4,
      "url": "https://git.sr.ht/~kennylevinsen/seatd/archive/${version}.tar.gz",
      "sha256": "819979c922a0be258aed133d93920bce6a3d3565a60588d6d372ce9db2712cd3",
      "notes": "Seat management without PAM. Trinix has no PAM stack, so logind never opens a session and libseat's logind backend has nothing to talk to; seatd is the backend that was written for exactly that situation. NOTE: sr.ht auto-generated archive."
    },
    "wlroots": {
      "version": "0.19.3",
      "phase": 4,
      "url": "https://gitlab.freedesktop.org/wlroots/wlroots/-/releases/${version}/downloads/wlroots-${version}.tar.gz",
      "sha256": "5d02693175e5afd9af5f10e3e4976d6e9249dc39a90eb17d23fa5f54b125ccc5",
      "notes": "Modesetting, buffer management and the protocol implementations the C# compositor drives. The 0.19 series rather than 0.20: it is what the binding layer in base/recipes/trinix-wlr is written against, and an ABI that moves under a hand-curated binding is a debugging session, not an upgrade."
    },
    "tzdata": {
      "version": "2025a",
      "phase": 2,
      "url": "https://data.iana.org/time-zones/releases/tzdata${version}.tar.gz",
      "sha256": "4d5fcbc72c7c450ebfe0b659bd0f1c02fbf52fd7f517a9ea13fe71c21eb5f0d0"
    }
  }
}
